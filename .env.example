# --- Server & Docker ---
WEB_PORT=8999
HLS_OUTPUT_DIR=/data/hls

# --- Input Source ---
# Supported modes: rtsp | v4l2 | avfoundation | lavfi | file
SOURCE_TYPE=rtsp
SOURCE_URL=rtsp://mock-camera:8554/live
SOURCE_WIDTH=1280
SOURCE_HEIGHT=720
SOURCE_FPS=30

# --- Transcoding & HLS-fMP4 ---
# Supported modes: auto | always | remux
TRANSCODE_MODE=auto
ENCODER_PRESET=ultrafast
ENCODER_BITRATE_KBPS=2000
ENCODER_THREADS=2
HLS_SEGMENT_DURATION=2
HLS_LIVE_LIST_SIZE=5
PLAYBACK_RETENTION_SEC=1800

# --- Local AI Inference ---
AI_ENABLED=true
AI_MODEL_PATH=/app/models/yolov8n_320.onnx
AI_CONF_THRESHOLD=0.45
AI_THREADS=2
AI_TARGET_CLASSES=person,car,truck,bicycle

# --- Profiling & Testing Flags ---
AI_SYNC_MODE=false
USE_BUFFER_POOL=true
SYNTHETIC_DETECTIONS=false
MAX_DURATION_SEC=0

# --- Resilience & Logging ---
READ_TIMEOUT_MS=5000
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=30000
PROFILING_LOG_INTERVAL_SEC=5
